{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Noctusoft": "Debug"
    }
  },
  "EzAzureLocalKeyVault": {
    "UseLocalKeyVault": true,
    "LocalKeyVaultOptions": {
      "VaultFilePath": ".local-vault.development.json",
      "LogSubstitutions": true
    }
  }
}
