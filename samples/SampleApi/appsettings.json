{
  "AllowedHosts": "*",
  "ElasticSearch": {
    "Environment": "$(APA-Platform-Prefix)",
    "Uri": "$(APA-ElasticCloud-Logging-URI)",
    "Username": "$(APA-ELASTIC-CLOUD-USERNAME)",
    "Password": "$(APA-ELASTIC-CLOUD-PASSWORD)",
    "Prefix": "mobile",
    "ServiceType": "api",
    "ServiceName": "pilot"
  },
  "ConnectionStrings": {
    "MobileDB": "Data Source=$(APA-DATABASE-SHARED-HOST);Initial Catalog=$(APA-Platform-Prefix).Mobile;User Id=$(APA-DATABASE-MOBILE-USERNAME);Password=$(APA-DATABASE-MOBILE-PASSWORD);Encrypt=True;MultipleActiveResultSets=True"
  },
  "JwtSettings": {
    "AuthenticationScheme": "Bearer",
    "ValidateIssuer": true,
    "ValidateIssuerSigningKey": true,
    "ValidateAudience": true,
    "UsernameClaimName": "apaempid",
    "Authority": "$(APA-OpenIdConnect-Authority)",
    "MetadataAddress": "$(APA-OpenIdConnect-MetadataAddress)",
    "ValidIssuer": "$(APA-OpenIdConnect-ValidIssuer)",
    "ValidAudiences": "swagger-ui,https://sentinel.alliedpilots.org,microsoft:identityserver:a50832d3-b2a8-4b05-9072-03f6ee8155c8,https://commute.alliedpilots.org,https://apapilotmobile3.alliedpilots.org"
  },
  "NotificationHub": {
    "ConnectionString": "$(APA-NOTIFICATIONHUB-CONNECTIONSTRING)",
    "Name": "integ-inbox-apapilot3",
    "EnableDetailedErrors": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EzLocalKeyVault": {
    "VaultFilePath": ".local-vault.json",
    "ReloadOnChange": true,
    "LogSubstitutions": true,
    "RedactionPatterns": ["password", "secret", "key", "token"]
  }
}
